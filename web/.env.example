# MySQL (same database as Streamlit frontend)
DATABASE_URL="mysql://user:password@localhost:3306/swc_ai_engine"

# Flask analysis engine
BACKEND_URL="https://swc-ai-engine-clean.onrender.com"
ANALYZE_TIMEOUT_SECONDS=240
# Health check: Render cold starts need longer timeouts (seconds per attempt)
HEALTH_TIMEOUT_SECONDS=60
HEALTH_RETRIES=3

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Google OAuth (from Google Cloud Console)
# In Credentials → your Web client → Authorized redirect URIs, add EXACTLY:
#   http://localhost:3000/api/auth/callback/google
# (Streamlit used port 8501 — Next.js uses 3000 + /api/auth/callback/google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: set to "demo" for local login without Google (server + client)
AUTH_MODE="google"
NEXT_PUBLIC_AUTH_MODE="google"
