generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model analysis_requests {
  id                   Int      @id @default(autoincrement())
  user_id              Int
  latitude             Float
  longitude            Float
  land_use             String
  backend_status       String?
  response_json        Json
  created_at           DateTime @default(now())
  recommendation_mode  String?
  recommended_measures Json?
  erosion_risk_level   String?
  erosion_risk_score   Float?
  users                users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analysis_requests_ibfk_1")

  @@index([land_use], map: "ix_analysis_requests_land_use")
  @@index([user_id], map: "ix_analysis_requests_user_id")
}

model user_sessions {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  session_token_hash String   @unique(map: "ix_user_sessions_session_token_hash")
  auth_provider      String
  started_at         DateTime @default(now())
  last_seen_at       DateTime @default(now())
  users              users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_sessions_ibfk_1")

  @@index([user_id], map: "ix_user_sessions_user_id")
}

model users {
  id                Int                 @id @default(autoincrement())
  google_sub        String              @unique(map: "ix_users_google_sub")
  email             String              @unique(map: "ix_users_email")
  name              String?
  picture_url       String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @default(now())
  last_login_at     DateTime?
  analysis_requests analysis_requests[]
  user_sessions     user_sessions[]
}
